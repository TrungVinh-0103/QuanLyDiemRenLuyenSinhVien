@model QLDiemRenLuyen.ViewModels.TuDanhGiaViewModel
@{
    var nhomTieuChis = Model.NhomTieuChi;
    var chiTiet = Model.ChiTietPhieu;
}
<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">Chi tiết phiếu đánh giá</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <p>
        <strong>Sinh viên:</strong> @ViewBag.SinhVien?.HoTen (@ViewBag.SinhVien?.MaSV) -
        <strong>Lớp:</strong> @ViewBag.SinhVien?.Lop?.TenLop
    </p>
    <p><strong>Học kỳ:</strong> @ViewBag.HocKy?.TenHocKy - @ViewBag.HocKy?.NamHoc</p>

    <form id="formCapNhatDiemGV">
        <input type="hidden" name="phieuDanhGiaId" value="@Model.PhieuDanhGiaID" />
        @if (nhomTieuChis != null)
        {
                @foreach (var nhom in nhomTieuChis)
                {
                    <div class="card mt-3">
                        <div class="card-header bg-info text-white">
                            @nhom.TenNhom (Tối đa: @nhom.DiemToiDa)
                        </div>
                        <div class="card-body">
                            <table class="table table-bordered text-center" data-diem-toi-da="@nhom.DiemToiDa">
                                <thead>
                                    <tr>
                                        <th>Nội dung</th>
                                        <th>SV tự đánh giá</th>
                                        <th>GVCN đề xuất</th>
                                        <th>HĐ duyệt</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (nhom.TieuChi != null)
                                    {
                                        @foreach (var tc in nhom.TieuChi)
                                        {
                                            var ct = chiTiet!.FirstOrDefault(x => x.TieuChiID == tc.TieuChiID);
                                            <tr>
                                                <td class="text-start">@tc.TenTieuChi</td>
                                                <td>
                                                    <input type="number" class="form-control text-center"
                                                           value="@(ct?.DiemTuDanhGia ?? 0)" min="0" max="@tc.DiemToiDa" readonly />
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control text-center input-diem diem-gv"
                                                           name="diemMoi[@tc.TieuChiID]"
                                                           value="@(ct?.DiemGiaoVienDeXuat ?? 0)" min="0" max="@tc.DiemToiDa" />
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control text-center"
                                                           value="@(ct?.DiemHoiDongDuyet ?? 0)" min="0" max="@tc.DiemToiDa" readonly />
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold">
                                        <td>Tổng nhóm</td>
                                        <td class="tong-nhom-sv">@chiTiet!.Where(c => nhom.TieuChi!.Any(t => t.TieuChiID == c.TieuChiID)).Sum(c => c.DiemTuDanhGia ?? 0)</td>
                                        <td class="tong-nhom-gv">@chiTiet!.Where(c => nhom.TieuChi!.Any(t => t.TieuChiID == c.TieuChiID)).Sum(c => c.DiemGiaoVienDeXuat ?? 0)</td>
                                        <td class="tong-nhom-hd">@chiTiet!.Where(c => nhom.TieuChi!.Any(t => t.TieuChiID == c.TieuChiID)).Sum(c => c.DiemHoiDongDuyet ?? 0)</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }
            }
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Tổng điểm toàn phiếu</h5>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-around align-items-center">
                    <p class="mb-2 mb-md-0 mx-2 fs-5">
                        Tổng điểm <span class="fw-bold text-success">Sinh viên</span>: <span id="tong-sv" class="fw-bold text-success">@Model.TongDiemTuDanhGia</span>
                    </p>
                    <p class="mb-2 mb-md-0 mx-2 fs-5">
                        Tổng điểm <span class="fw-bold text-info">Giáo viên</span>: <span id="tong-gv" class="fw-bold text-info">@(Model.ChiTietPhieu!.Sum(c => c.DiemGiaoVienDeXuat ?? 0))</span>
                    </p>
                    <p class="mb-0 mx-2 fs-5">
                        Tổng điểm <span class="fw-bold text-danger">Hội đồng</span>: <span id="tong-hd" class="fw-bold text-danger">@(Model.ChiTietPhieu!.Sum(c => c.DiemHoiDongDuyet ?? 0))</span>
                    </p>
                </div>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
    <button type="button" id="btnLuuGV" class="btn btn-success">Lưu thay đổi</button>
</div>